{
  "schema": "receipt-binding-conformance-v1",
  "about": "Shared by the Swift engine (PackReceiptBinding.verify, ReceiptBindingConformanceTests) and the Python launcher (verify_receipt_binding, scripts/tests/test_receipt_binding_conformance.py). Each case builds a small tree, builds the receipt files map from it, and expects status plus, for a mismatch, the first difference's kind and path. files: relative path -> {text} or {size} (size bytes of 'x'); dirs: empty directories; symlinks: link -> relative target (the target need not exist). receiptFiles: 'fromTree' computes {size, sha256} for every entry of files, otherwise the value is the receipt's files value verbatim; omitted means the receipt has no files key. receiptExclude drops listed names; receiptOverrides replaces entry keys (null removes one; upperSha256 upper-cases the computed sha256); receiptExtra adds entries ({copyFrom} takes size and sha256 from a created file). hashMaxBytes overrides the hash threshold. reasonContains is a substring of the uncheckable reason.",
  "cases": [
    {
      "id": "ok-matching-tree",
      "why": "Every listed file matches in size and sha256 and nothing else is present.",
      "files": {
        "a.txt": {
          "text": "alpha"
        },
        "b.txt": {
          "text": "bravo!"
        }
      },
      "receiptFiles": "fromTree",
      "expect": {
        "status": "ok",
        "kind": null,
        "path": null
      }
    },
    {
      "id": "size-differs",
      "why": "A listed file's recorded size differs from the bytes found.",
      "files": {
        "a.txt": {
          "text": "alpha"
        },
        "b.txt": {
          "text": "bravo!"
        }
      },
      "receiptFiles": "fromTree",
      "receiptOverrides": {
        "a.txt": {
          "size": 6
        }
      },
      "expect": {
        "status": "mismatch",
        "kind": "size",
        "path": "a.txt"
      }
    },
    {
      "id": "sha256-differs",
      "why": "Same size, different recorded sha256, within the hash threshold.",
      "files": {
        "a.txt": {
          "text": "alpha"
        },
        "b.txt": {
          "text": "bravo!"
        }
      },
      "receiptFiles": "fromTree",
      "receiptOverrides": {
        "b.txt": {
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      },
      "expect": {
        "status": "mismatch",
        "kind": "sha256",
        "path": "b.txt"
      }
    },
    {
      "id": "missing-listed-file",
      "why": "A listed file that is not in the pack.",
      "files": {
        "a.txt": {
          "text": "alpha"
        },
        "b.txt": {
          "text": "bravo!"
        }
      },
      "receiptFiles": "fromTree",
      "receiptExtra": {
        "gone.bin": {
          "copyFrom": "a.txt"
        }
      },
      "expect": {
        "status": "mismatch",
        "kind": "missing",
        "path": "gone.bin"
      }
    },
    {
      "id": "unlisted-top-level-file",
      "why": "A file in the pack that the receipt does not list.",
      "files": {
        "a.txt": {
          "text": "alpha"
        },
        "b.txt": {
          "text": "bravo!"
        },
        "extra.txt": {
          "text": "x"
        }
      },
      "receiptFiles": "fromTree",
      "receiptExclude": [
        "extra.txt"
      ],
      "expect": {
        "status": "mismatch",
        "kind": "unlisted",
        "path": "extra.txt"
      }
    },
    {
      "id": "unlisted-nested-file",
      "why": "An unlisted file beside a listed one inside a listed directory prefix.",
      "files": {
        "a.txt": {
          "text": "alpha"
        },
        "b.txt": {
          "text": "bravo!"
        },
        "sub/x.txt": {
          "text": "x"
        },
        "sub/y.txt": {
          "text": "y"
        }
      },
      "receiptFiles": "fromTree",
      "receiptExclude": [
        "sub/y.txt"
      ],
      "expect": {
        "status": "mismatch",
        "kind": "unlisted",
        "path": "sub/y.txt"
      }
    },
    {
      "id": "unlisted-inside-unlisted-directory",
      "why": "A real directory the receipt does not mention is walked; its first file is named.",
      "files": {
        "a.txt": {
          "text": "alpha"
        },
        "b.txt": {
          "text": "bravo!"
        },
        "extra/inner.txt": {
          "text": "x"
        }
      },
      "receiptFiles": "fromTree",
      "receiptExclude": [
        "extra/inner.txt"
      ],
      "expect": {
        "status": "mismatch",
        "kind": "unlisted",
        "path": "extra/inner.txt"
      }
    },
    {
      "id": "dot-components-are-ignored",
