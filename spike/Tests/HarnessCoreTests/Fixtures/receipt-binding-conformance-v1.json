        "kind": "missing",
        "path": "d"
      }
    },
    {
      "id": "size-only-above-hash-threshold",
      "why": "A file larger than the hash threshold is checked by size only; a wrong sha256 is not opened.",
      "files": {
        "big.bin": {
          "size": 8
        }
      },
      "receiptFiles": "fromTree",
      "receiptOverrides": {
        "big.bin": {
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      },
      "hashMaxBytes": 4,
      "expect": {
        "status": "ok",
        "kind": null,
        "path": null
      }
    },
    {
      "id": "hash-threshold-is-inclusive",
      "why": "A file exactly at the hash threshold is hashed.",
      "files": {
        "edge.bin": {
          "size": 4
        }
      },
      "receiptFiles": "fromTree",
      "receiptOverrides": {
        "edge.bin": {
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      },
      "hashMaxBytes": 4,
      "expect": {
        "status": "mismatch",
        "kind": "sha256",
        "path": "edge.bin"
      }
    },
    {
      "id": "uppercase-recorded-sha256-is-compared-lowercased",
