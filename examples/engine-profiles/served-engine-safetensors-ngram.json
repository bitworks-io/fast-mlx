{
  "schema": "fastmlx-engine-profile-v1",
  "name": "served-engine-safetensors-ngram",
  "argv": [
    "{engine_bin}",
    "--serve",
    "--model",
    "{model_path}",
    "--host",
    "{host}",
    "--port",
    "{port}",
    "--ctx-size",
    "{context}"
  ],
  "fitCheck": {
    "bin": "builtin:safetensors",
    "args": ["--kv-reserve-gib", "8", "--mmap-side-file", "ngram_table.bin"]
  }
}
